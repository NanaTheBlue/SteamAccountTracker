# .env — copy this to /opt/cheaterwatch/.env on the server (or .env for local dev)

# === Production (docker-compose.prod.yml) ===
# Your domain — Caddy uses this to auto-provision a Let's Encrypt TLS cert
DOMAIN=your-domain.com

# SQL Server SA password (strong, unique per environment)
DB_PASSWORD=Your_password123

# === Backend (WebApplication1) ===
CONNECTION_STRING=Server=tcp:sqlserver,1433;Initial Catalog=CheaterWatch;User ID=sa;Password=Your_password123;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;
STEAM_API_KEY=your_steam_api_key_here
WORKER_KEY=your_secure_worker_key_here
FRONTEND_URL=https://your-domain.com
RESEND_API_KEY=your_resend_api_key_here
